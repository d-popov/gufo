# gufo-monitor settings. Copy to tools/monitor/.env (git-ignored) or to
# $XDG_CONFIG_HOME/gufo-monitor/.env, or pass --env-file FILE. Variables set in the
# process environment win over this file. Format: KEY=VALUE per line, `#` comments,
# optional single or double quotes; nothing is expanded.

# The public URL of the monitor's listener, e.g. your Cloudflare tunnel's hostname.
# Verification links, wallet-link messages and the portal's base use it, never the
# Host header of a request. http:// or https:// and a host only (no path); a trailing
# slash is dropped. Default: http://<--bind>:<--port>.
GUFO_PUBLIC_URL=https://gufo.example.com

# Gufo's public OpenAI-compatible base URL, shown to portal users. The monitor does
# not proxy /v1: route that path to Gufo in the tunnel (an ingress rule) or point this
# at Gufo's own public hostname. Default: $GUFO_PUBLIC_URL/v1.
#GUFO_API_URL=https://api.example.com/v1
